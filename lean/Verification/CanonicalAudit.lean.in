import Lean
import Lean.Replay

/-! The exact expected propositions are elaborated before implementation imports.
At runtime implementations load with extensions disabled, so their syntax and
initializers cannot alter the specification or this auditor. -/
open Lean

private structure AxiomState where
  visited : NameSet := {}
  axioms : Array Name := #[]

private partial def collectDirect (env : Environment) (name : Name) :
    StateT AxiomState IO Unit := do
  unless (← get).visited.contains name do
    modify fun state => { state with visited := state.visited.insert name }
    let some info := env.checked.get.find? name |
      throw <| IO.userError s!"Missing logical dependency: {name}"
    if info.isUnsafe || info.isPartial then
      throw <| IO.userError s!"Logical declaration depends on unsafe/partial {name}"
    match info with
    | .axiomInfo value =>
      modify fun state => { state with axioms := state.axioms.push name }
      value.type.getUsedConstants.forM (collectDirect env)
    | .quotInfo _ => pure ()
    | _ => info.getUsedConstantsAsSet.toList.forM (collectDirect env)

private def checkAxioms (env : Environment) (targets : List Name) : IO Unit := do
  let (_, state) ← (targets.forM (collectDirect env)).run {}
  let allowed : List Name := [`propext, `Classical.choice, `Quot.sound]
  for name in state.axioms do
    unless allowed.contains name do
      throw <| IO.userError s!"Forbidden axiom in canonical dependencies: {name}"

def main (args : List String) : IO Unit := do
  let args := match args with | "--" :: rest => rest | _ => args
  unless args == ["--focused"] || args == ["--verified-module-replay"] do
    throw <| IO.userError "Unexpected canonical audit arguments"
  initSearchPath (← findSysroot)
  let env ← importModules #[@@CANDIDATE_IMPORTS@@] {}
    (loadExts := false) (level := .private)
  let targets := [`SubGaussian.Current.general, `SubGaussian.Current.unit]
  for suffix in ["general", "unit"] do
    let name := ("SubGaussian.Current." ++ suffix).toName
    let some info := env.checked.get.find? name |
      throw <| IO.userError s!"Missing canonical target: {name}"
    unless info.isTheorem do
      throw <| IO.userError s!"Canonical target must be a theorem declaration: {name}"
    unless info.levelParams.length == 1 do
      throw <| IO.userError s!"Wrong universe parameters for canonical target: {name}"
    let levels := [Level.param `canonicalUniverse]
    let actual := info.type.instantiateLevelParams info.levelParams levels
    let expected := mkConst (("CanonicalAcceptanceExpected." ++ suffix).toName) levels
    unless Kernel.isDefEqGuarded env {} actual expected do
      throw <| IO.userError s!"Wrong exact canonical type: {name}"
  -- Full module replay already audits every declaration and its dependencies.
  if args != ["--verified-module-replay"] then checkAxioms env targets
  IO.println "CANONICAL_ACCEPTANCE_COMPLETE 2 targets"
