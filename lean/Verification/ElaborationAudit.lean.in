namespace CanonicalDirectAudit
open Lean

-- This supplemental elaboration audit also reads actual checked bodies,
-- never the imported axiom-summary extension used by Lean.collectAxioms.
private structure DirectAxiomState where
  visited : NameSet := {}
  axioms : Array Name := #[]

private partial def collectDirect (env : Environment) (name : Name) :
    StateT DirectAxiomState IO Unit := do
  unless (← get).visited.contains name do
    modify fun state => { state with visited := state.visited.insert name }
    let some info := env.checked.get.find? name |
      throw <| IO.userError s!"Missing logical dependency: {name}"
    if info.isUnsafe || info.isPartial then
      throw <| IO.userError s!"Logical declaration depends on unsafe/partial {name}"
    match info with
    | .axiomInfo value =>
      modify fun state => { state with axioms := state.axioms.push name }
      value.type.getUsedConstants.forM (collectDirect env)
    | .quotInfo _ => pure ()
    | _ => info.getUsedConstantsAsSet.toList.forM (collectDirect env)

run_cmd do
  let env := (← getEnv).setExporting false
  let newAxioms := env.constants.fold (fun acc name info =>
    if info.isAxiom && !info.isUnsafe then
      match env.getModuleIdxFor? name with
      | none => name :: acc
      | some idx =>
        let origin := env.allImportedModuleNames[idx.toNat]!
        if (`SingularValueBounds).isPrefixOf origin || origin == `CanonicalTrustedConstants
          then name :: acc else acc
    else acc) ([] : List Name)
  for name in newAxioms do
    throwError "Forbidden axiom declared by canonical implementation: {name}"
  let targets : List Name := [@@TARGET_NAMES@@]
  for name in targets do
    unless (env.checked.get.find? name).isSome do
      throwError "Canonical acceptance target is not kernel checked: {name}"
  let (_, state) ← (targets.forM (collectDirect env)).run {}
  let allowed : List Name := [`propext, `Classical.choice, `Quot.sound]
  for name in state.axioms do
    unless allowed.contains name do
      throwError "Forbidden axiom in canonical acceptance dependencies: {name}"
  logInfo "CANONICAL_OBLIGATIONS_ELABORATED @@TARGET_COUNT@@ targets; independent replay required"

end CanonicalDirectAudit
