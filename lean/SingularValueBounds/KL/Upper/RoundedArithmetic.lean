import SingularValueBounds.KL.Certificates.Enclosures

/-! # Soundness of rounded arithmetic transcripts (supplementary S1.6.3)

Every field below is a finite rational comparison. The transcript may be
generated by the printed integer fixed-point recurrences. Lean proves the
analytic interpretation once, without re-evaluating the large tables.
-/
open scoped BigOperators
namespace SingularValueBounds.KL.Certificates
noncomputable section
set_option maxHeartbeats 1200000

def factorialTerm (x : ℝ) (j : ℕ) : ℝ := x^j/(j.factorial : ℝ)

theorem factorialTerm_succ (x : ℝ) (j : ℕ) :
    factorialTerm x (j+1)=factorialTerm x j*x/(j+1 : ℝ) := by
  simp only [factorialTerm,pow_succ,Nat.factorial_succ,Nat.cast_mul,Nat.cast_add,Nat.cast_one]
  field_simp [show (j.factorial : ℝ)≠0 by positivity,show (j : ℝ)+1≠0 by positivity]
  <;> ring
  <;> simp

structure ExpLowerTranscript (N : ℕ) (x out : ℚ) (term : ℕ → ℚ) : Prop where
  argument : 0≤x
  initial : term 0≤1
  step : ∀j∈Finset.range N,term (j+1)≤term j*x/(j+1 : ℚ)
  output : out≤∑j∈Finset.range (N+1),term j

structure ExpUpperTranscript (N : ℕ) (x out : ℚ) (term : ℕ → ℚ) : Prop where
  argument : 0≤x
  domain : x<N+2
  initial : 1≤term 0
  step : ∀j∈Finset.range N,term j*x/(j+1 : ℚ)≤term (j+1)
  output : (∑j∈Finset.range (N+1),term j)+
    (term N*x/(N+1 : ℚ))/(1-x/(N+2 : ℚ))≤out

theorem ExpLowerTranscript.term_le {N : ℕ} {x out : ℚ} {term : ℕ → ℚ}
    (h : ExpLowerTranscript N x out term) {j : ℕ} (hj : j≤N) :
    (term j : ℝ)≤factorialTerm x j := by
  induction j with
  | zero => simpa [factorialTerm] using (show (term 0 : ℝ)≤1 by exact_mod_cast h.initial)
  | succ j ih =>
    have hstep := h.step j (Finset.mem_range.mpr (by omega))
    have hc : (term (j+1) : ℝ)≤(term j : ℝ)*(x : ℝ)/(j+1 : ℝ) := by exact_mod_cast hstep
    have hx : (0 : ℝ)≤x := by exact_mod_cast h.argument
    rw [factorialTerm_succ]
    exact hc.trans (div_le_div_of_nonneg_right
      (mul_le_mul_of_nonneg_right (ih (by omega)) hx) (by positivity))

theorem ExpLowerTranscript.sound {N : ℕ} {x out : ℚ} {term : ℕ → ℚ}
    (h : ExpLowerTranscript N x out term) : (out : ℝ)≤Real.exp (x : ℝ) := by
  have ho : (out : ℝ)≤∑j∈Finset.range (N+1),(term j : ℝ) := by exact_mod_cast h.output
  have hs := Finset.sum_le_sum (s := Finset.range (N+1))
    (fun j hj => h.term_le (j := j) (by have := Finset.mem_range.mp hj; omega))
  exact (ho.trans hs).trans (expTaylor_le_exp N (by exact_mod_cast h.argument))

theorem ExpUpperTranscript.term_ge {N : ℕ} {x out : ℚ} {term : ℕ → ℚ}
    (h : ExpUpperTranscript N x out term) {j : ℕ} (hj : j≤N) :
    factorialTerm x j≤(term j : ℝ) := by
  induction j with
  | zero => simpa [factorialTerm] using (show (1 : ℝ)≤term 0 by exact_mod_cast h.initial)
  | succ j ih =>
    have hstep := h.step j (Finset.mem_range.mpr (by omega))
    have hc : (term j : ℝ)*(x : ℝ)/(j+1 : ℝ)≤(term (j+1) : ℝ) := by exact_mod_cast hstep
    have hx : (0 : ℝ)≤x := by exact_mod_cast h.argument
    rw [factorialTerm_succ]
    exact (div_le_div_of_nonneg_right
      (mul_le_mul_of_nonneg_right (ih (by omega)) hx) (by positivity)).trans hc

theorem ExpUpperTranscript.sound {N : ℕ} {x out : ℚ} {term : ℕ → ℚ}
    (h : ExpUpperTranscript N x out term) : Real.exp (x : ℝ)≤(out : ℝ) := by
  have hx : (0 : ℝ)≤x := by exact_mod_cast h.argument
  have hdom : (x : ℝ)<N+2 := by exact_mod_cast h.domain
  have ho : (∑j∈Finset.range (N+1),(term j : ℝ))+
      ((term N : ℝ)*(x : ℝ)/(N+1 : ℝ))/(1-(x : ℝ)/(N+2 : ℝ))≤(out : ℝ) := by
    exact_mod_cast h.output
  have hs := Finset.sum_le_sum (s := Finset.range (N+1))
    (fun j hj => h.term_ge (j := j) (by have := Finset.mem_range.mp hj; omega))
  have hn := h.term_ge (j := N) le_rfl
  have hd : 0≤1-(x : ℝ)/(N+2 : ℝ) := by
    have hh := (div_lt_one (by positivity : (0 : ℝ)<N+2)).mpr hdom
    linarith
  have hnext := div_le_div_of_nonneg_right
    (mul_le_mul_of_nonneg_right hn hx) (by positivity : (0 : ℝ)≤N+1)
  have hrem := div_le_div_of_nonneg_right hnext hd
  have he := exp_le_expTaylorUpper N hx hdom
  have hident : (x : ℝ)^(N+1)/((N+1).factorial : ℝ)=
      factorialTerm x N*(x : ℝ)/(N+1 : ℝ) := factorialTerm_succ x N
  dsimp [expTaylorUpper] at he
  rw [hident] at he
  have hsum : expTaylor N x≤∑j∈Finset.range (N+1),(term j : ℝ) := hs
  exact he.trans ((add_le_add hsum hrem).trans ho)

/-- Negative exponent branch: a positive rounded lower sum is inverted. -/
theorem exp_neg_upper_of_lower_transcript {N : ℕ} {x lo out : ℚ} {term : ℕ → ℚ}
    (h : ExpLowerTranscript N x lo term) (hlo : 0<lo) (hout : 1/lo≤out) :
    Real.exp (-(x : ℝ))≤(out : ℝ) := by
  exact (exp_neg_le_reciprocal (by exact_mod_cast hlo) h.sound).trans
    (by exact_mod_cast hout)

structure LogTranscript (N : ℕ) (z lo hi : ℚ)
    (powerLo powerHi coeffLo coeffHi : ℕ → ℚ) : Prop where
  argument : 0≤z
  domain : z<1
  powerLoNonneg : ∀j∈Finset.range (N+1),0≤powerLo j
  powerHiNonneg : ∀j∈Finset.range (N+1),0≤powerHi j
  initialLo : powerLo 0≤z
  initialHi : z≤powerHi 0
  stepLo : ∀j∈Finset.range N,powerLo (j+1)≤powerLo j*z^2
  stepHi : ∀j∈Finset.range N,powerHi j*z^2≤powerHi (j+1)
  lowerCoefficient : ∀j∈Finset.range N,coeffLo j≤2*powerLo j/(2*(j : ℚ)+1)
  upperCoefficient : ∀j∈Finset.range N,2*powerHi j/(2*(j : ℚ)+1)≤coeffHi j
  lower : lo≤∑j∈Finset.range N,coeffLo j
  upper : (∑j∈Finset.range N,coeffHi j)+
    2*powerHi N/((2*(N : ℚ)+1)*(1-z^2))≤hi

theorem LogTranscript.powers {N : ℕ} {z lo hi : ℚ}
    {pl ph cl ch : ℕ → ℚ} (h : LogTranscript N z lo hi pl ph cl ch)
    {j : ℕ} (hj : j≤N) : (pl j : ℝ)≤(z : ℝ)^(2*j+1) ∧
      (z : ℝ)^(2*j+1)≤(ph j : ℝ) := by
  induction j with
  | zero =>
    constructor
    · simpa using (show (pl 0 : ℝ)≤z by exact_mod_cast h.initialLo)
    · simpa using (show (z : ℝ)≤ph 0 by exact_mod_cast h.initialHi)
  | succ j ih =>
    have hp := ih (by omega)
    have hL : (pl (j+1) : ℝ)≤(pl j : ℝ)*(z : ℝ)^2 := by
      exact_mod_cast h.stepLo j (Finset.mem_range.mpr (by omega))
    have hH : (ph j : ℝ)*(z : ℝ)^2≤(ph (j+1) : ℝ) := by
      exact_mod_cast h.stepHi j (Finset.mem_range.mpr (by omega))
    have hid : (z : ℝ)^(2*(j+1)+1)=(z : ℝ)^(2*j+1)*(z : ℝ)^2 := by
      rw [← pow_add]
      congr 1 <;> omega
    rw [hid]
    exact ⟨hL.trans (mul_le_mul_of_nonneg_right hp.1 (sq_nonneg _)),
      (mul_le_mul_of_nonneg_right hp.2 (sq_nonneg _)).trans hH⟩

theorem LogTranscript.sound {N : ℕ} {z lo hi : ℚ}
    {pl ph cl ch : ℕ → ℚ} (h : LogTranscript N z lo hi pl ph cl ch) :
    (lo : ℝ)≤Real.log ((1+(z : ℝ))/(1-(z : ℝ))) ∧
      Real.log ((1+(z : ℝ))/(1-(z : ℝ)))≤(hi : ℝ) := by
  have hz : (0 : ℝ)≤z := by exact_mod_cast h.argument
  have hz1 : (z : ℝ)<1 := by exact_mod_cast h.domain
  have hlow : (lo : ℝ)≤logTaylor N z := by
    have ho : (lo : ℝ)≤∑j∈Finset.range N,(cl j : ℝ) := by exact_mod_cast h.lower
    apply ho.trans
    apply Finset.sum_le_sum
    intro j hj
    have hc : (cl j : ℝ)≤2*(pl j : ℝ)/(2*(j : ℝ)+1) := by exact_mod_cast h.lowerCoefficient j hj
    have hp := (h.powers (j := j) (by have := Finset.mem_range.mp hj; omega)).1
    have hh := div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left hp (by norm_num : (0 : ℝ)≤2))
      (by positivity : (0 : ℝ)≤2*(j : ℝ)+1)
    convert! hc.trans hh using 1 <;> ring
  have hupp : logTaylorUpper N z≤(hi : ℝ) := by
    have ho : (∑j∈Finset.range N,(ch j : ℝ))+
        2*(ph N : ℝ)/((2*(N : ℝ)+1)*(1-(z : ℝ)^2))≤(hi : ℝ) := by exact_mod_cast h.upper
    have hsum : logTaylor N z≤∑j∈Finset.range N,(ch j : ℝ) := by
      apply Finset.sum_le_sum
      intro j hj
      have hc : 2*(ph j : ℝ)/(2*(j : ℝ)+1)≤(ch j : ℝ) := by exact_mod_cast h.upperCoefficient j hj
      have hp := (h.powers (j := j) (by have := Finset.mem_range.mp hj; omega)).2
      have hh := div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left hp (by norm_num : (0 : ℝ)≤2))
        (by positivity : (0 : ℝ)≤2*(j : ℝ)+1)
      convert! hh.trans hc using 1 <;> ring
    have hd : 0≤(2*(N : ℝ)+1)*(1-(z : ℝ)^2) := by
      have hs : 0≤1-(z : ℝ)^2 := by nlinarith
      exact mul_nonneg (by positivity) hs
    have hrem := div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left
      (h.powers (j := N) le_rfl).2 (by norm_num : (0 : ℝ)≤2)) hd
    exact (add_le_add hsum hrem).trans ho
  exact ⟨hlow.trans (logTaylor_le_log_ratio N hz hz1),
    (log_ratio_le_logTaylorUpper N hz hz1).trans hupp⟩

end
end SingularValueBounds.KL.Certificates
