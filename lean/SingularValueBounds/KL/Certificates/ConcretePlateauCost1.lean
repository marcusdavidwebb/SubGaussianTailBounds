theorem plateauCost_range_1 :
    IntervalCertificate (-plateauCostE 1) (plateauCostLo 1) (plateauCostHi 1) 4
      (bernsteinCoefficients ((-plateauCostE 1).comp
        (affine (plateauCostLo 1) (plateauCostHi 1-plateauCostLo 1))) 4) ∧
    IntervalCertificate (plateauCostD 1-C (1/1000000)) (plateauCostLo 1) (plateauCostHi 1) 4
      (bernsteinCoefficients ((plateauCostD 1-C (1/1000000)).comp
        (affine (plateauCostLo 1) (plateauCostHi 1-plateauCostLo 1))) 4) ∧
    IntervalCertificate (plateauCostMargin 1) (plateauCostLo 1) (plateauCostHi 1) 100
      (bernsteinCoefficients ((plateauCostMargin 1).comp
        (affine (plateauCostLo 1) (plateauCostHi 1-plateauCostLo 1))) 100) := by
  simpa [plateauCostLo, plateauCostHi] using
    And.intro plateauCost_1_0 (And.intro plateauCost_1_1 plateauCost_1_2)

