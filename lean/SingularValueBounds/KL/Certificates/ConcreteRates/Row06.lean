theorem concrete_rate_row_6 :
    ∀ cell ∈ (rateTrees 6).leaves 0 ((rateRows 6).1-1),
      IntervalCertificate (ratePolynomial (rateRows 6).1 (rateRows 6).2)
        cell.1 cell.2 27
        (bernsteinCoefficients ((ratePolynomial (rateRows 6).1 (rateRows 6).2).comp
          (affine cell.1 (cell.2-cell.1))) 27) := by
  intro cell hc
  have hrow : rateRows 6 = ((11/5), (1/2500)) := by rfl
  rw [hrow] at hc ⊢
  have hleaves : (rateTrees 6).leaves 0 ((11/5)-1) =
      [((0/1), (3/40)), ((3/40), (9/80)), ((9/80), (3/20)), ((3/20), (3/10)), ((3/10), (3/5)), ((3/5), (6/5))] := by decide +kernel
  rw [hleaves] at hc
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl | rfl | rfl | rfl | rfl
  · exact rate_6_leaf_0
  · exact rate_6_leaf_1
  · exact rate_6_leaf_2
  · exact rate_6_leaf_3
  · exact rate_6_leaf_4
  · exact rate_6_leaf_5

