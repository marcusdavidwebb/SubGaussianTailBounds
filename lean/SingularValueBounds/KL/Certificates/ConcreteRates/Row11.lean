theorem concrete_rate_row_11 :
    ∀ cell ∈ (rateTrees 11).leaves 0 ((rateRows 11).1-1),
      IntervalCertificate (ratePolynomial (rateRows 11).1 (rateRows 11).2)
        cell.1 cell.2 27
        (bernsteinCoefficients ((ratePolynomial (rateRows 11).1 (rateRows 11).2).comp
          (affine cell.1 (cell.2-cell.1))) 27) := by
  intro cell hc
  have hrow : rateRows 11 = ((11/4), (79/10000)) := by rfl
  rw [hrow] at hc ⊢
  have hleaves : (rateTrees 11).leaves 0 ((11/4)-1) =
      [((0/1), (7/32)), ((7/32), (7/16)), ((7/16), (7/8)), ((7/8), (7/4))] := by decide +kernel
  rw [hleaves] at hc
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl | rfl | rfl
  · exact rate_11_leaf_0
  · exact rate_11_leaf_1
  · exact rate_11_leaf_2
  · exact rate_11_leaf_3

