theorem concrete_rate_row_13 :
    ∀ cell ∈ (rateTrees 13).leaves 0 ((rateRows 13).1-1),
      IntervalCertificate (ratePolynomial (rateRows 13).1 (rateRows 13).2)
        cell.1 cell.2 27
        (bernsteinCoefficients ((ratePolynomial (rateRows 13).1 (rateRows 13).2).comp
          (affine cell.1 (cell.2-cell.1))) 27) := by
  intro cell hc
  have hrow : rateRows 13 = ((7/2), (131/5000)) := by rfl
  rw [hrow] at hc ⊢
  have hleaves : (rateTrees 13).leaves 0 ((7/2)-1) =
      [((0/1), (5/16)), ((5/16), (15/32)), ((15/32), (5/8)), ((5/8), (5/4)), ((5/4), (5/2))] := by decide +kernel
  rw [hleaves] at hc
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl | rfl | rfl | rfl
  · exact rate_13_leaf_0
  · exact rate_13_leaf_1
  · exact rate_13_leaf_2
  · exact rate_13_leaf_3
  · exact rate_13_leaf_4

