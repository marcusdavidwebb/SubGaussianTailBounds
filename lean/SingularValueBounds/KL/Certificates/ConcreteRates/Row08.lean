theorem concrete_rate_row_8 :
    ∀ cell ∈ (rateTrees 8).leaves 0 ((rateRows 8).1-1),
      IntervalCertificate (ratePolynomial (rateRows 8).1 (rateRows 8).2)
        cell.1 cell.2 27
        (bernsteinCoefficients ((ratePolynomial (rateRows 8).1 (rateRows 8).2).comp
          (affine cell.1 (cell.2-cell.1))) 27) := by
  intro cell hc
  have hrow : rateRows 8 = ((12/5), (21/10000)) := by rfl
  rw [hrow] at hc ⊢
  have hleaves : (rateTrees 8).leaves 0 ((12/5)-1) =
      [((0/1), (7/40)), ((7/40), (7/20)), ((7/20), (7/10)), ((7/10), (7/5))] := by decide +kernel
  rw [hleaves] at hc
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl | rfl | rfl
  · exact rate_8_leaf_0
  · exact rate_8_leaf_1
  · exact rate_8_leaf_2
  · exact rate_8_leaf_3

