theorem concrete_rate_row_9 :
    ∀ cell ∈ (rateTrees 9).leaves 0 ((rateRows 9).1-1),
      IntervalCertificate (ratePolynomial (rateRows 9).1 (rateRows 9).2)
        cell.1 cell.2 27
        (bernsteinCoefficients ((ratePolynomial (rateRows 9).1 (rateRows 9).2).comp
          (affine cell.1 (cell.2-cell.1))) 27) := by
  intro cell hc
  have hrow : rateRows 9 = ((9/4), (7/10000)) := by rfl
  rw [hrow] at hc ⊢
  have hleaves : (rateTrees 9).leaves 0 ((9/4)-1) =
      [((0/1), (5/64)), ((5/64), (5/32)), ((5/32), (5/16)), ((5/16), (5/8)), ((5/8), (5/4))] := by decide +kernel
  rw [hleaves] at hc
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl | rfl | rfl | rfl
  · exact rate_9_leaf_0
  · exact rate_9_leaf_1
  · exact rate_9_leaf_2
  · exact rate_9_leaf_3
  · exact rate_9_leaf_4

