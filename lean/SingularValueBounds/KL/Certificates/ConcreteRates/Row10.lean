theorem concrete_rate_row_10 :
    ∀ cell ∈ (rateTrees 10).leaves 0 ((rateRows 10).1-1),
      IntervalCertificate (ratePolynomial (rateRows 10).1 (rateRows 10).2)
        cell.1 cell.2 27
        (bernsteinCoefficients ((ratePolynomial (rateRows 10).1 (rateRows 10).2).comp
          (affine cell.1 (cell.2-cell.1))) 27) := by
  intro cell hc
  have hrow : rateRows 10 = ((5/2), (7/2000)) := by rfl
  rw [hrow] at hc ⊢
  have hleaves : (rateTrees 10).leaves 0 ((5/2)-1) =
      [((0/1), (3/16)), ((3/16), (3/8)), ((3/8), (3/4)), ((3/4), (3/2))] := by decide +kernel
  rw [hleaves] at hc
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl | rfl | rfl
  · exact rate_10_leaf_0
  · exact rate_10_leaf_1
  · exact rate_10_leaf_2
  · exact rate_10_leaf_3

