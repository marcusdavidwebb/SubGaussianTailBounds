    endpointJointPrefactorQ (endpointMeanCornerK 5 1 (1 : Fin 4)) (endpointMeanCornerA 5 1 (1 : Fin 4))
      ((r.rate:ℚ)/100) = fixedQ (prefactors (1 : Fin 4) r.rate) := by
