    endpointJointPrefactorQ (endpointMeanCornerK 14 15 h) (endpointMeanCornerA 14 15 h)
      ((r.rate:ℚ)/100) = fixedQ (prefactors h r.rate) := by
  intro h
  fin_cases h
  · exact prefactorValues0
  · exact prefactorValues1
  · exact prefactorValues2
  · exact prefactorValues3
private theorem totalBounds : ∀ h : Fin 4,
    endpointEntropyByRuns (endpointMeanCutoff 14 15) (prefactors h) runs ≤
      endpointMeanCorner 14 15 h := by decide +kernel

theorem numerical : ∀ h : Fin 4,
