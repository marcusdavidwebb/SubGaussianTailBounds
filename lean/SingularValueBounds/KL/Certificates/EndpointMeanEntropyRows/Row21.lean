private theorem prefactorValues : ∀ h : Fin 4, ∀ r ∈ runs,
    endpointJointPrefactorQ (endpointMeanCornerK 21 21 h) (endpointMeanCornerA 21 21 h)
      ((r.rate:ℚ)/100) = fixedQ (prefactors h r.rate) := by
  intro h
  fin_cases h
  · exact prefactorValues0
  · exact prefactorValues1
  · exact prefactorValues2
  · exact prefactorValues3
private theorem totalBounds : ∀ h : Fin 4,
    endpointEntropyByRuns (endpointMeanCutoff 21 21) (prefactors h) runs ≤
      endpointMeanCorner 21 21 h := by decide +kernel

theorem numerical : ∀ h : Fin 4,
    endpointMeanNumericCorner 21 21 h ≤ endpointMeanCorner 21 21 h :=
  endpointMeanNumericCorner_le_of_runs 21 21 (by unfold endpointMeanActive; decide +kernel) runs prefactors
    cover domains rates prefactorValues totalBounds
end SingularValueBounds.KL.Certificates.EndpointEntropyBox21_21

namespace SingularValueBounds.KL.Certificates
theorem endpointMeanEntropyRow21 (ai : Fin 42)
    (hactive : endpointMeanActive 21 ai) (h : Fin 4) :
    endpointMeanNumericCorner 21 ai h ≤ endpointMeanCorner 21 ai h := by
  fin_cases ai
  · exact False.elim ((by unfold endpointMeanActive; decide +kernel : ¬ endpointMeanActive 21 0) hactive)
