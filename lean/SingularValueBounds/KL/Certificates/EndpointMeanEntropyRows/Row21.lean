      s.rate = r.rate ∧ SingularValueBounds.KL.Certificates.EndpointEntropyBox21_19.prefactors (3 : Fin 4) s.rate = prefactors (2 : Fin 4) r.rate := by decide +kernel
  intro r hr
  obtain ⟨s, hs, hrate, hvalue⟩ := bridge r hr
