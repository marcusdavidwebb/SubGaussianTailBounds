theorem numerical : ∀ h : Fin 4,
    endpointMeanNumericCorner 12 16 h ≤ endpointMeanCorner 12 16 h :=
  endpointMeanNumericCorner_le_of_runs 12 16 (by unfold endpointMeanActive; decide +kernel) runs prefactors
    cover domains rates prefactorValues totalBounds
