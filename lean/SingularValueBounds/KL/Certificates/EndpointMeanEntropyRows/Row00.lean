    endpointMeanNumericCorner 0 10 h ≤ endpointMeanCorner 0 10 h :=
  endpointMeanNumericCorner_le_of_runs 0 10 (by unfold endpointMeanActive; decide +kernel) runs prefactors
    cover domains rates prefactorValues totalBounds
