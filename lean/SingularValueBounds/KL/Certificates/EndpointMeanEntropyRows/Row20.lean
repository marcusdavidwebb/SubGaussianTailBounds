      endpointMeanCorner 20 11 h := by decide +kernel

theorem numerical : ∀ h : Fin 4,
    endpointMeanNumericCorner 20 11 h ≤ endpointMeanCorner 20 11 h :=
  endpointMeanNumericCorner_le_of_runs 20 11 (by unfold endpointMeanActive; decide +kernel) runs prefactors
    cover domains rates prefactorValues totalBounds
