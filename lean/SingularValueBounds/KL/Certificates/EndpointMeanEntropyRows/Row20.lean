    endpointMeanNumericCorner 20 16 h ≤ endpointMeanCorner 20 16 h :=
  endpointMeanNumericCorner_le_of_runs 20 16 (by unfold endpointMeanActive; decide +kernel) runs prefactors
    cover domains rates prefactorValues totalBounds
