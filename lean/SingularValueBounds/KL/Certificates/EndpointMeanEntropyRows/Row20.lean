    endpointEntropyByRuns (endpointMeanCutoff 20 17) (prefactors h) runs ≤
      endpointMeanCorner 20 17 h := by decide +kernel

theorem numerical : ∀ h : Fin 4,
    endpointMeanNumericCorner 20 17 h ≤ endpointMeanCorner 20 17 h :=
  endpointMeanNumericCorner_le_of_runs 20 17 (by unfold endpointMeanActive; decide +kernel) runs prefactors
    cover domains rates prefactorValues totalBounds
