    endpointJointPrefactorQ (endpointMeanCornerK 16 16 h) (endpointMeanCornerA 16 16 h)
      ((r.rate:ℚ)/100) = fixedQ (prefactors h r.rate) := by
  intro h
  fin_cases h
  · exact prefactorValues0
  · exact prefactorValues1
  · exact prefactorValues2
  · exact prefactorValues3
private theorem totalBounds : ∀ h : Fin 4,
    endpointEntropyByRuns (endpointMeanCutoff 16 16) (prefactors h) runs ≤
      endpointMeanCorner 16 16 h := by decide +kernel

