    endpointMeanNumericCorner 17 16 h ≤ endpointMeanCorner 17 16 h :=
  endpointMeanNumericCorner_le_of_runs 17 16 (by unfold endpointMeanActive; decide +kernel) runs prefactors
    cover domains rates prefactorValues totalBounds
