private theorem cover : EndpointRunsCover (endpointMeanCutoff 17 3) 8000 runs := by decide +kernel
private theorem domains : ∀ r ∈ runs,
    90 ≤ r.rate ∧ r.rate ≤ 200 ∧ r.start ≤ r.stop ∧ r.stop ≤ 8000 := by decide +kernel
private theorem rates : ∀ r ∈ runs, EndpointRateRunValid 17 3 r := by decide +kernel
private theorem prefactorValues : ∀ h : Fin 4, ∀ r ∈ runs,
    endpointJointPrefactorQ (endpointMeanCornerK 17 3 h) (endpointMeanCornerA 17 3 h)
      ((r.rate:ℚ)/100) = fixedQ (prefactors h r.rate) := by
  simp only [endpointJointPrefactorQ, endpointJointLogUpperQ,
    logRoundedQ, logPositiveRoundedQ, logReductionQ, natLog_two_eq_logTwoFuel]
  simp only [logUnitLowerQ_two, logUnitUpperQ_two]
  simp only [logUnitLowerQ_eq_int, logUnitUpperQ_eq_int, expUpperRoundedQ_eq_integer]
  decide +kernel
private theorem totalBounds : ∀ h : Fin 4,
    endpointEntropyByRuns (endpointMeanCutoff 17 3) (prefactors h) runs ≤
      endpointMeanCorner 17 3 h := by decide +kernel

theorem numerical : ∀ h : Fin 4,
    endpointMeanNumericCorner 17 3 h ≤ endpointMeanCorner 17 3 h :=
  endpointMeanNumericCorner_le_of_runs 17 3 (by unfold endpointMeanActive; decide +kernel) runs prefactors
    cover domains rates prefactorValues totalBounds
