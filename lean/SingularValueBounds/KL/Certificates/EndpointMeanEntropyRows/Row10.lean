private theorem prefactorValues : ∀ h : Fin 4, ∀ r ∈ runs,
    endpointJointPrefactorQ (endpointMeanCornerK 10 12 h) (endpointMeanCornerA 10 12 h)
      ((r.rate:ℚ)/100) = fixedQ (prefactors h r.rate) := by
  intro h
  fin_cases h
  · exact prefactorValues0
  · exact prefactorValues1
  · exact prefactorValues2
  · exact prefactorValues3
private theorem totalBounds : ∀ h : Fin 4,
    endpointEntropyByRuns (endpointMeanCutoff 10 12) (prefactors h) runs ≤
      endpointMeanCorner 10 12 h := by decide +kernel

theorem numerical : ∀ h : Fin 4,
    endpointMeanNumericCorner 10 12 h ≤ endpointMeanCorner 10 12 h :=
  endpointMeanNumericCorner_le_of_runs 10 12 (by unfold endpointMeanActive; decide +kernel) runs prefactors
