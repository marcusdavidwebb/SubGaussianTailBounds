theorem numerical : ∀ h : Fin 4,
    endpointMeanNumericCorner 15 18 h ≤ endpointMeanCorner 15 18 h :=
  endpointMeanNumericCorner_le_of_runs 15 18 (by unfold endpointMeanActive; decide +kernel) runs prefactors
    cover domains rates prefactorValues totalBounds
