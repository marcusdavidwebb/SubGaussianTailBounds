    endpointJointPrefactorQ (endpointMeanCornerK 19 20 h) (endpointMeanCornerA 19 20 h)
      ((r.rate:ℚ)/100) = fixedQ (prefactors h r.rate) := by
  intro h
  fin_cases h
  · exact prefactorValues0
  · exact prefactorValues1
  · exact prefactorValues2
  · exact prefactorValues3
private theorem totalBounds : ∀ h : Fin 4,
    endpointEntropyByRuns (endpointMeanCutoff 19 20) (prefactors h) runs ≤
      endpointMeanCorner 19 20 h := by decide +kernel

theorem numerical : ∀ h : Fin 4,
    endpointMeanNumericCorner 19 20 h ≤ endpointMeanCorner 19 20 h :=
  endpointMeanNumericCorner_le_of_runs 19 20 (by unfold endpointMeanActive; decide +kernel) runs prefactors
    cover domains rates prefactorValues totalBounds
