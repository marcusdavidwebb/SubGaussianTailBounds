private theorem plateauCost_0_0 :
    IntervalCertificate (-plateauCostE 0) (71/100) (147/200) 4
      (bernsteinCoefficients ((-plateauCostE 0).comp (affine (71/100) ((147/200)-(71/100)))) 4) := by
  refine Or.inr ⟨by norm_num, ?_⟩
  let coefficients : Fin 5 → ℚ := ![(6751622182187/2385625000000),
      (45164602251/1908500000000),
      (774698393/1526800000000),
      (-334451/4771250000),
      (-269867/244288000000)]
  let raw : Fin 5 → ℚ := ![(131850673/38170000),
      (-64723/22000),
      (69230927/38170000),
      (39/11),
      (-269867/95425)]
  have hraw : (-plateauCostE 0) = Polynomial.ofFn 5 raw := by
    rw [Polynomial.ofFn_eq_sum_monomial]
    apply Polynomial.funext
    intro x
    norm_num [raw, plateauCostMargin, plateauCostD, plateauCostE,
      plateauCostA, plateauCostV, plateauCostU, plateauCostW, plateauCostC,
      polynomialExpTaylor, Finset.sum_range_succ, affine, Polynomial.eval_comp,
      Polynomial.eval_add, Polynomial.eval_sub, Polynomial.eval_mul, Polynomial.eval_pow,
      Polynomial.eval_neg, Polynomial.eval_C, Polynomial.eval_X, Fin.sum_univ_succ,
      Polynomial.eval_finset_sum, Polynomial.eval_monomial]
    ring
  have hpoly : (-plateauCostE 0).comp (affine (71/100) ((147/200)-(71/100))) =
      Polynomial.ofFn 5 coefficients := by
    rw [hraw]
    apply ofFn_comp_affine_eq 4
    simp only [Fin.sum_univ_succ, Fin.sum_univ_zero, add_zero, Nat.choose_eq_fast_choose]
    decide +kernel
  rw [hpoly]
  constructor
  · apply polynomial_bernstein_identity
    exact Nat.le_of_lt_succ (Polynomial.ofFn_natDegree_lt (by norm_num) coefficients)
  · simp_rw [bernsteinCoefficients_ofFn]
    simp only [Fin.sum_univ_succ, Fin.sum_univ_zero, add_zero, Nat.choose_eq_fast_choose]
    decide +kernel

