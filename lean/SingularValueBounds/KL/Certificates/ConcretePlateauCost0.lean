theorem plateauCost_range_0 :
    IntervalCertificate (-plateauCostE 0) (plateauCostLo 0) (plateauCostHi 0) 4
      (bernsteinCoefficients ((-plateauCostE 0).comp
        (affine (plateauCostLo 0) (plateauCostHi 0-plateauCostLo 0))) 4) ∧
    IntervalCertificate (plateauCostD 0-C (1/1000000)) (plateauCostLo 0) (plateauCostHi 0) 4
      (bernsteinCoefficients ((plateauCostD 0-C (1/1000000)).comp
        (affine (plateauCostLo 0) (plateauCostHi 0-plateauCostLo 0))) 4) ∧
    IntervalCertificate (plateauCostMargin 0) (plateauCostLo 0) (plateauCostHi 0) 100
      (bernsteinCoefficients ((plateauCostMargin 0).comp
        (affine (plateauCostLo 0) (plateauCostHi 0-plateauCostLo 0))) 100) := by
  simpa [plateauCostLo, plateauCostHi] using
    And.intro plateauCost_0_0 (And.intro plateauCost_0_1 plateauCost_0_2)

